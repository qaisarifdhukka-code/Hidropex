---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GlobalPresenceMap from '../components/GlobalPresenceMap.tsx';
import QualityProcessSection from '../components/QualityProcessSection.astro';
import ConversionSection from '../components/ConversionSection.astro';
---

<Layout title="Company | HIDROPEX">
  <PageHero 
    title="About HIDROPEX" 
    description="Engineering hydraulic connections since 1978. A legacy of quality, precision, and global reach." 
    bgImage="https://www.hidropex.cl/wp-content/uploads/2026/06/1780319596630-640x400.jpg"
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-2 gap-4 items-center">
        <div>
          <h2 class="text-xs text-muted" style="margin-bottom: 0.5rem; letter-spacing: 0.05em; font-weight: 600;">WHO WE ARE</h2>
          <h3 class="text-3xl text-primary" style="margin-bottom: 1.5rem;">ENGINEERED FOR EXCELLENCE.</h3>
          <p class="text-sm" style="margin-bottom: 1rem; line-height: 1.6;">
            HIDROPEX was founded on a simple principle: hydraulic systems are only as strong as their weakest connection. For over four decades, we have dedicated ourselves to manufacturing precision tube fittings and fluid power connections that eliminate failure points in critical industrial machinery.
          </p>
          <p class="text-sm" style="margin-bottom: 1.5rem; line-height: 1.6;">
            Today, our products are trusted by leading original equipment manufacturers (OEMs) in agriculture, construction, mining, and heavy industry globally. We don't just supply parts; we provide engineered solutions that guarantee zero-defect performance under the most extreme pressures.
          </p>
          <div class="grid grid-2 gap-4" style="margin-top: 2rem;">
            <div>
              <div class="text-3xl text-primary counter-element" data-target="45" data-suffix="+" style="font-weight: 700;">0+</div>
              <div class="text-xs text-muted" style="font-weight: 600;">YEARS EXPERIENCE</div>
            </div>
            <div>
              <div class="text-3xl text-primary counter-element" data-target="10" data-suffix="M+" style="font-weight: 700;">0M+</div>
              <div class="text-xs text-muted" style="font-weight: 600;">PARTS ANNUALLY</div>
            </div>
          </div>
        </div>
        <div class="img-box" style="aspect-ratio: 4/5; border-radius: var(--radius-md); overflow: hidden;">
          <img src="https://www.hidropex.cl/wp-content/uploads/2026/06/1780319596630-640x400.jpg" alt="Hidropex Engineering Facility" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>
    </div>
  </section>

  <QualityProcessSection />

  <GlobalPresenceMap client:idle />
  <ConversionSection />

  <script>
    document.addEventListener('astro:page-load', () => {
      const counters = document.querySelectorAll('.counter-element');
      const speed = 100;

      const animateCounters = (entries, observer) => {
        entries.forEach(entry => {
          const el = entry.target;
          const suffix = el.getAttribute('data-suffix') || '';

          if (entry.isIntersecting) {
            const target = +el.getAttribute('data-target');
            let count = 0;
            const inc = target / speed;

            const updateCount = () => {
              count += inc;
              if (count < target) {
                el.innerText = Math.ceil(count) + suffix;
                requestAnimationFrame(updateCount);
              } else {
                el.innerText = target + suffix;
              }
            };

            updateCount();
          } else {
            // Reset to 0 when scrolled out of view
            el.innerText = '0' + suffix;
          }
        });
      };

      const observer = new IntersectionObserver(animateCounters, {
        threshold: 0.5
      });

      counters.forEach(counter => {
        observer.observe(counter);
      });
    });
  </script>
</Layout>
