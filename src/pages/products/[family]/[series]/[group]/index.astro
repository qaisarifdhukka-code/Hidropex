---
import Layout from '../../../../../layouts/Layout.astro';
import ProductBreadcrumb from '../../../../../components/products/ProductBreadcrumb.astro';
import ProductPageLayout from '../../../../../components/products/ProductPageLayout.astro';
import ProductGroupCard from '../../../../../components/products/ProductGroupCard.astro';
import TechnicalViewer from '../../../../../components/products/TechnicalViewer.tsx';
import SpecificationTable from '../../../../../components/products/SpecificationTable.astro';
import { getAllProductFamilies } from '../../../../../utils/productData';
import type { ProductFamily } from '../../../../../types/product';

export async function getStaticPaths() {
  const families = getAllProductFamilies();
  const paths: any[] = [];
  
  families.forEach((family) => {
    family.seriesList.forEach((series) => {
      const seriesSlug = series.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
      const groupsInSeries = family.groups.filter(g => g.series === series);
      
      groupsInSeries.forEach((group) => {
        paths.push({
          params: { family: family.slug, series: seriesSlug, group: group.slug },
          props: { family, seriesName: series, group },
        });
      });
    });
  });
  
  return paths;
}

const { family, seriesName, group } = Astro.props;

// If exactly one product, we will display it directly on this page instead of a redundant grid
const isSingleProduct = group.products && group.products.length === 1;
const product = isSingleProduct ? group.products[0] : null;
---

<Layout title={`${group.name} | ${family.name} | HIDROPEX`}>
  <main class="section section-bg-gray" style="min-height: 80vh; padding-top: 4rem;">
    <div class="container">
      
      <ProductBreadcrumb paths={[
        { name: family.name, url: `/products/${family.slug}` },
        { name: seriesName, url: `/products/${family.slug}/${Astro.params.series}` },
        { name: group.name }
      ]} />

      <div style="margin-bottom: 3rem;">
        <h1 class="text-3xl" style="color: var(--color-navy-dark); margin-bottom: 1rem; font-weight: 700;">{group.name.toUpperCase()}</h1>
        {isSingleProduct && product ? (
          <p class="text-sm text-muted" style="max-width: 800px;">{product.description}</p>
        ) : (
          <p class="text-sm text-muted" style="max-width: 800px;">Select a specific product from the {group.name} range.</p>
        )}
      </div>

      <ProductPageLayout
        familySlug={family.slug}
        seriesList={family.seriesList}
        activeSeries={seriesName}
      >
        {isSingleProduct && product ? (
          <>
            <!-- Main Product Display Split -->
            <div class="grid grid-2 gap-4" style="margin-bottom: 4rem; align-items: stretch;">
              
              <!-- Left: Technical Viewer -->
              <div style="background: white; border: 1px solid var(--color-border-color); padding: 1.5rem; border-radius: var(--radius-md); box-shadow: var(--shadow-card);">
                <TechnicalViewer 
                  client:idle
                  productName={product.name}
                  bodyUrl={product.bodyDrawingUrl}
                  assemblyUrl={product.assemblyDrawingUrl}
                  fallbackImageUrl={product.productImageUrl}
                />
              </div>

              <!-- Right: Specifications and CTAs -->
              <div class="flex flex-col gap-4">
                <div style="background: white; border: 1px solid var(--color-border-color); padding: 0; border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-card);">
                  <h3 class="text-xs text-muted" style="margin: 0; padding: 1.5rem; border-bottom: 1px solid var(--color-border-color);">KEY SPECIFICATIONS</h3>
                  
                  <div class="flex flex-col">
                    <div class="flex justify-between" style="padding: 1rem 1.5rem; background-color: var(--color-bg-gray); border-bottom: 1px solid var(--color-border-color);">
                      <span class="text-sm font-bold text-primary">Category</span>
                      <span class="text-sm text-muted">{product.specs?.category || '-'}</span>
                    </div>
                    <div class="flex justify-between" style="padding: 1rem 1.5rem; background-color: white; border-bottom: 1px solid var(--color-border-color);">
                      <span class="text-sm font-bold text-primary">Tube O.D. Range</span>
                      <span class="text-sm text-muted">{product.specs?.tubeODRange || '-'}</span>
                    </div>
                    <div class="flex justify-between" style="padding: 1rem 1.5rem; background-color: var(--color-bg-gray);">
                      <span class="text-sm font-bold text-primary">Part Type</span>
                      <span class="text-sm text-muted">{product.specs?.partType || '-'}</span>
                    </div>
                  </div>

                  <div class="flex flex-col gap-2 mobile-sticky-cta" style="padding: 1.5rem; border-top: 1px solid var(--color-border-color); background: white;">
                    <a href="#quote" class="btn btn-primary text-center" style="display: flex; justify-content: center; flex: 1;">REQUEST A QUOTE ↗</a>
                    {product.brochureUrl && (
                      <a href={product.brochureUrl} class="btn btn-outline text-center" style="display: flex; justify-content: center; flex: 1;">DOWNLOAD BROCHURE ↓</a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </>
        ) : group.products && group.products.length > 0 ? (
          <div class="grid grid-4 grid-2-mobile gap-4">
            {group.products.map((p: any) => (
              <ProductGroupCard 
                name={p.name}
                url={`/products/${family.slug}/${Astro.params.series}/${group.slug}/${p.slug}`}
                imageUrl={p.productImageUrl}
                actionText="VIEW DETAILS ↗"
                specs={p.specs}
              />
            ))}
          </div>
        ) : (
          <div style="padding: 3rem; text-align: center; background: white; border: 1px solid var(--color-border-color); border-radius: var(--radius-sm);">
            <p class="text-muted">No individual products found for this group yet.</p>
          </div>
        )}
      </ProductPageLayout>

      <!-- Bottom: Dimensional Table -->
      {isSingleProduct && product && product.dimensionalData && product.dimensionalData.length > 0 && (
        <div style="margin-top: 4rem;">
          <h3 class="text-xl text-primary" style="margin-bottom: 1rem; font-weight: 600;">DIMENSIONAL DATA</h3>
          <SpecificationTable data={product.dimensionalData} />
        </div>
      )}

    </div>
  </main>
</Layout>

<style>
  .flex-grow { flex-grow: 1; width: 100%; }
  
  @media (max-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr !important;
    }
  }

  @media (min-width: 768px) {
    .md-flex-row { flex-direction: row !important; }
  }
</style>
