---
import Layout from '../../../layouts/Layout.astro';
import TopBar from '../../../components/TopBar.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ProductBreadcrumb from '../../../components/products/ProductBreadcrumb.astro';
import ProductPageLayout from '../../../components/products/ProductPageLayout.astro';
import ProductGroupCard from '../../../components/products/ProductGroupCard.astro';
import { getAllProductFamilies } from '../../../utils/productData';
import type { ProductFamily } from '../../../types/product';

export async function getStaticPaths() {
  const families = getAllProductFamilies();
  return families.map((family) => ({
    params: { family: family.slug },
    props: { family },
  }));
}

const { family } = Astro.props as { family: ProductFamily };

// The default series to show is 'ALL PRODUCTS'.
const defaultSeries = 'ALL PRODUCTS';
const defaultGroups = family.groups;
---

<Layout title={`${family.name} | HIDROPEX`}>
  <TopBar />
  <Header />

  <main class="section section-bg-gray" style="min-height: 80vh; padding-top: 4rem;">
    <div class="container">
      
      <ProductBreadcrumb paths={[
        { name: family.name }
      ]} />

      <div style="margin-bottom: 3rem;">
        <h1 class="text-3xl" style="color: var(--color-navy-dark); margin-bottom: 1rem; font-weight: 700;">{family.name.toUpperCase()}</h1>
        <p class="text-sm text-muted" style="max-width: 800px;">{family.description}</p>
      </div>

      <ProductPageLayout
        familySlug={family.slug}
        seriesList={family.seriesList}
        activeSeries={defaultSeries}
      >
        <div class="grid grid-4 grid-2-mobile gap-4">
          {defaultGroups.map((group) => {
            const seriesSlug = group.series.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '');
            const hasSingleProduct = group.products && group.products.length === 1;
            const url = `/products/${family.slug}/${seriesSlug}/${group.slug}`;
            const actionText = hasSingleProduct ? "VIEW DETAILS ↗" : "VIEW PRODUCTS ↗";
            
            return (
              <ProductGroupCard 
                name={group.name}
                url={url}
                imageUrl={group.groupImageUrl}
                actionText={actionText}
                description={group.description}
                specs={group.products && group.products.length > 0 ? group.products[0].specs : undefined}
              />
            );
          })}
        </div>
      </ProductPageLayout>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  .flex-grow { flex-grow: 1; width: 100%; }
  
  @media (min-width: 768px) {
    .md-flex-row { flex-direction: row; }
  }
</style>
