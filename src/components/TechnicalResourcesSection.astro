<section id="resources" class="section">
  <div class="container">
    <div class="flex justify-between items-center" style="margin-bottom: 2rem;">
      <h2 class="text-xs flex flex-col-mobile gap-2" style="align-items: flex-start;">
        <div class="flex items-center gap-2"><span class="text-primary">09</span> TECHNICAL RESOURCES</div>
        <span class="text-muted" style="font-weight: 500; font-size: 0.7rem;">DOCUMENT RAIL</span>
      </h2>
    </div>

    <div class="grid grid-4 gap-4 mobile-slider" style="padding-bottom: 1rem;">
      <div class="card flex flex-col gap-2" style="height: 100%;">
        <div class="img-box" style="aspect-ratio: 4/3; margin-bottom: 1rem; border-radius: var(--radius-sm); padding: 0; overflow: hidden;">
          <img src="https://www.hy-techengineers.com/images/product2.jpg" alt="Catalogue" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <h3 class="text-sm font-bold text-primary" style="text-transform: uppercase;">PRODUCT CATALOGUES</h3>
        <p class="text-xs text-muted" style="margin-bottom: 1rem; text-transform: uppercase;">DIN Metric, JIC Tube, ORFS and Conversion Adaptors.</p>
        <a href="#" class="text-xs text-primary" style="font-weight: 700; margin-top: auto; text-transform: uppercase;">VIEW CATALOGUES ↘</a>
      </div>
      
      <div class="card flex flex-col gap-2" style="height: 100%;">
        <div class="img-box" style="aspect-ratio: 4/3; margin-bottom: 1rem; border-radius: var(--radius-sm); padding: 0; overflow: hidden;">
          <img src="https://www.hy-techengineers.com/images/main-slider/image-1b.png" alt="Datasheets" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <h3 class="text-sm font-bold text-primary" style="text-transform: uppercase;">TECHNICAL PRODUCT INFORMATION</h3>
        <p class="text-xs text-muted" style="margin-bottom: 1rem; text-transform: uppercase;">Product families, configurations and connection types.</p>
        <a href="#" class="text-xs text-primary" style="font-weight: 700; margin-top: auto; text-transform: uppercase;">EXPLORE PRODUCTS ↗</a>
      </div>
      
      <div class="card flex flex-col gap-2" style="height: 100%;">
        <div class="img-box" style="aspect-ratio: 4/3; margin-bottom: 1rem; border-radius: var(--radius-sm); padding: 0; overflow: hidden;">
          <img src="https://www.hidropex.cl/wp-content/uploads/2026/06/ASITENCIA-TECNICA-2-611x400.png" alt="Certificates" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <h3 class="text-sm font-bold text-primary" style="text-transform: uppercase;">QUALITY CERTIFICATES</h3>
        <p class="text-xs text-muted" style="margin-bottom: 1rem; text-transform: uppercase;">Quality, environmental and management-system certifications.</p>
        <a href="#" class="text-xs text-primary" style="font-weight: 700; margin-top: auto; text-transform: uppercase;">VIEW CERTIFICATES ↗</a>
      </div>
      
      <div class="card flex flex-col gap-2" style="height: 100%;">
        <div class="img-box" style="aspect-ratio: 4/3; margin-bottom: 1rem; border-radius: var(--radius-sm); padding: 0; overflow: hidden;">
          <img src="https://www.hidropex.cl/wp-content/uploads/2026/06/IMAGENESSERVICIO-TERRENO-2-2-611x400.png" alt="Engineering Guide" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
        <h3 class="text-sm font-bold text-primary" style="text-transform: uppercase;">ENGINEERING SUPPORT</h3>
        <p class="text-xs text-muted" style="margin-bottom: 1rem; text-transform: uppercase;">Product development, prototype machining and application-specific testing.</p>
        <a href="#" class="text-xs text-primary" style="font-weight: 700; margin-top: auto; text-transform: uppercase;">EXPLORE CAPABILITIES ↗</a>
      </div>
    </div>
  </div>
</section>
