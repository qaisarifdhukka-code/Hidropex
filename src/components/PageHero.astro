---
interface Props {
  title: string;
  description: string;
  bgImage: string;
}

const { title, description, bgImage } = Astro.props;
---

<section style="position: relative; padding: 6rem 0; overflow: hidden; background-color: var(--color-navy-dark); color: white; display: flex; align-items: center; justify-content: center; text-align: center;">
  <!-- Background Image with Gradient Overlay -->
  <div style="position: absolute; inset: 0; z-index: 1;">
    <img src={bgImage} alt="" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.5;" />
    <div style="position: absolute; inset: 0; background: linear-gradient(to right, rgba(10, 18, 30, 0.95), rgba(10, 18, 30, 0.7));"></div>
  </div>
  
  <div class="container" style="position: relative; z-index: 2;">
    <h1 class="text-3xl text-white" style="margin-bottom: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">{title}</h1>
    <p class="text-sm" style="color: rgba(255,255,255,0.85); max-width: 600px; margin: 0 auto; line-height: 1.6;">
      {description}
    </p>
  </div>
</section>
