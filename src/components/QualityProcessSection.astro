---
---
<section class="section section-bg-gray">
  <div class="container">
    <div class="grid grid-2 gap-mobile-2 items-center">
      <div class="flex flex-col gap-4" style="max-width: 500px;">
        <h2 class="text-xs flex flex-col-mobile gap-2" style="align-items: flex-start;">
          <div class="flex items-center gap-2" style="letter-spacing: 0.1em;">COMPLIANCE</div>
          <span class="text-muted" style="font-weight: 500; font-size: 0.7rem;">ZERO DEFECT COMMITMENT</span>
        </h2>
        <h3 class="text-3xl text-primary">CERTIFIED EXCELLENCE.</h3>
        <p class="text-base text-muted">Every fitting leaving our facilities undergoes rigorous quality control to ensure it meets or exceeds international standards for hydraulic fluid power systems.</p>

        <div class="grid grid-2 gap-4" style="margin-top: 1rem;">

          <!-- IATF 16949 -->
          <div class="cert-badge" style="padding: 0.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </div>
            <div style="text-align: left;">
              <div class="text-sm font-bold text-primary">IATF 16949</div>
              <p class="text-xs text-muted" style="margin-top: 0.125rem;">AUTOMOTIVE QMS</p>
            </div>
          </div>

          <!-- ISO 9001 -->
          <div class="cert-badge" style="padding: 0.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4l3 3" />
              </svg>
            </div>
            <div style="text-align: left;">
              <div class="text-sm font-bold text-primary">ISO 9001</div>
              <p class="text-xs text-muted" style="margin-top: 0.125rem;">QUALITY MANAGEMENT</p>
            </div>
          </div>

          <!-- ISO 14001 -->
          <div class="cert-badge" style="padding: 0.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" />
                <path d="M8 12c0 2.21 1.79 4 4 4s4-1.79 4-4" />
                <path d="M12 16v4" />
                <path d="M12 4v4" />
                <path d="M15.5 10c-1.1 0-2-.9-2-2" />
                <path d="M8.5 10c1.1 0 2-.9 2-2" />
              </svg>
            </div>
            <div style="text-align: left;">
              <div class="text-sm font-bold text-primary">ISO 14001</div>
              <p class="text-xs text-muted" style="margin-top: 0.125rem;">ENVIRONMENTAL</p>
            </div>
          </div>

          <!-- RoHS / REACH -->
          <div class="cert-badge" style="padding: 0.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="width: 100%; height: 100%;">
                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                <path d="M9 12l2 2 4-4" />
              </svg>
            </div>
            <div style="text-align: left;">
              <div class="text-sm font-bold text-primary">ROHS / REACH</div>
              <p class="text-xs text-muted" style="margin-top: 0.125rem;">COMPLIANT PLATING</p>
            </div>
          </div>

        </div>
      </div>

      <div class="img-box" style="aspect-ratio: 4/3; border-radius: var(--radius-md); overflow: hidden;">
        <img src="https://www.hidropex.cl/wp-content/uploads/2026/06/IMAGENESSERVICIO-TERRENO-2-2-611x400.png" alt="Quality Control" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
    </div>
  </div>
</section>

<style>
  .cert-badge {
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .cert-badge:hover {
    transform: translateX(4px);
    opacity: 0.8;
  }
</style>
