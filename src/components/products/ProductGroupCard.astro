---
interface Props {
  name: string;
  url: string;
  imageUrl: string;
  actionText?: string;
  description?: string;
  specs?: {
    category?: string;
    tubeODRange?: string;
  };
}

const { name, url, imageUrl, actionText = "VIEW PRODUCTS", description, specs } = Astro.props;
const cleanActionText = actionText.replace(' ↗', '').replace('↗', '');
---

<a href={url} class="product-group-card flex flex-col">
  <div class="card-content">
    <div class="img-box">
      {imageUrl ? (
        <img src={imageUrl} alt={name} class="product-img" />
      ) : (
        <div style="color: var(--color-border-color);">[ NO IMAGE ]</div>
      )}
    </div>
    
    <div class="text-content">
      <h3 class="card-title">{name}</h3>
      {description && (
        <p class="card-description text-muted">{description}</p>
      )}
    </div>
    
    {specs && (
      <div class="specs-container">
        {specs.category && (
          <div class="spec-row text-muted" style="border-bottom: 1px solid var(--color-bg-gray);">
            <span class="spec-label">SERIES:</span> {specs.category}
          </div>
        )}
        {specs.tubeODRange && (
          <div class="spec-row text-muted" style="padding-top: 0.35rem;">
            <span class="spec-label">TUBE O.D.:</span> {specs.tubeODRange}
          </div>
        )}
      </div>
    )}

    {!specs && <div style="flex-grow: 1;"></div>}
  </div>
  
  <div class="action-bar">
    <span class="action-text">
      {cleanActionText}
    </span>
    <div class="action-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </div>
  </div>
</a>

<style is:global>
  .product-group-card {
    text-decoration: none;
    background: white;
    border: 1px solid var(--color-border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    height: 100%;
    transition: all var(--transition-fast);
    box-shadow: var(--shadow-card);
  }
  
  .product-group-card .card-content {
    padding: 1rem;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  
  @media (min-width: 768px) {
    .product-group-card .card-content {
      padding: 1.25rem 1.25rem 1rem 1.25rem;
    }
  }

  .product-group-card .img-box {
    aspect-ratio: 16/10;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 1rem;
    background-color: #ffffff;
    border-bottom: 1px solid var(--color-border-color);
  }

  .product-group-card .product-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: 0.75rem;
    transition: transform var(--transition-fast);
  }

  .product-group-card .text-content {
    margin-bottom: 0.5rem;
  }

  .product-group-card .card-title {
    font-size: 0.9rem;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 0.25rem;
    line-height: 1.3;
  }

  .product-group-card .card-description {
    font-size: 0.75rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: 0;
  }

  .product-group-card .specs-container {
    margin-top: auto;
    margin-bottom: 0;
  }

  .product-group-card .spec-row {
    font-size: 0.7rem;
    margin-bottom: 0.25rem;
  }

  .product-group-card .spec-row:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .product-group-card .spec-row {
      font-size: 0.75rem;
    }
  }

  .product-group-card .spec-label {
    font-weight: 700;
    color: var(--color-navy);
  }

  .product-group-card .action-bar {
    background-color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    transition: background-color var(--transition-fast);
  }

  .product-group-card .action-text {
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .product-group-card .action-icon {
    color: white;
    transition: transform var(--transition-fast);
    flex-shrink: 0;
    margin-left: 0.5rem;
  }

  .product-group-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-rigid);
    border-color: var(--color-primary);
  }

  .product-group-card:hover .product-img {
    transform: scale(1.1);
  }
  
  .product-group-card:hover .action-bar {
    background-color: var(--color-primary);
  }

  .product-group-card:hover .action-icon {
    transform: translateX(4px);
  }
</style>
