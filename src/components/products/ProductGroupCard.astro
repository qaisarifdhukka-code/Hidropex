---
interface Props {
  name: string;
  url: string;
  imageUrl: string;
  actionText?: string;
  specs?: {
    category?: string;
    tubeODRange?: string;
  };
}

const { name, url, imageUrl, actionText = "VIEW PRODUCTS ↗", specs } = Astro.props;
---

<a href={url} class="product-group-card flex flex-col" style="text-decoration: none;">
  <div class="img-box" style="aspect-ratio: 4/3; background: var(--color-bg-white); border: 1px solid var(--color-border-color); display: flex; align-items: center; justify-content: center; overflow: hidden; margin-bottom: 1rem;">
    {imageUrl ? (
      <img src={imageUrl} alt={name} style="max-width: 100%; max-height: 100%; object-fit: contain; padding: 1rem;" />
    ) : (
      <div style="color: var(--color-border-color);">[ NO IMAGE ]</div>
    )}
  </div>
  
  <h3 class="text-base text-primary" style="font-weight: 600; margin-bottom: 0.5rem;">{name}</h3>
  
  {specs && (
    <div style="margin-bottom: 1rem; flex-grow: 1;">
      {specs.category && (
        <div class="text-xs text-muted" style="margin-bottom: 0.25rem;">
          <span style="font-weight: 700; color: var(--color-navy);">Series:</span> {specs.category}
        </div>
      )}
      {specs.tubeODRange && (
        <div class="text-xs text-muted">
          <span style="font-weight: 700; color: var(--color-navy);">Tube O.D.:</span> {specs.tubeODRange}
        </div>
      )}
    </div>
  )}

  {!specs && <div style="flex-grow: 1;"></div>}
  
  <span class="text-xs action-text" style="color: var(--color-navy); font-weight: 700; transition: color var(--transition-fast);">
    {actionText}
  </span>
</a>

<style>
  .product-group-card {
    transition: transform var(--transition-fast);
  }
  
  .product-group-card:hover {
    transform: translateY(-4px);
  }
  
  .product-group-card:hover .img-box {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-rigid);
  }
  
  .product-group-card:hover .action-text {
    color: var(--color-primary) !important;
  }
</style>
